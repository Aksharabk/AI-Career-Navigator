<!DOCTYPE html>
<html lang="en">

<head>
	<meta charset="UTF-8" />
	<meta name="viewport" content="width=device-width, initial-scale=1.0" />
	<title>AI-POWERED CAREER GUIDANCE AND EMPLOYABILITY ENHANCEMENT PLATFORM - Assistant</title>
	<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.0/css/all.min.css">
	<link rel="stylesheet" href="css/chat.css" />
</head>

<body>
	<section class="side-bar">
		<button><i class="fa-solid fa-plus" style="margin-right: 6px;"></i>New Chat</button>
		<div class="history"></div>
		<div class="class">
			<p>Made by TechCoders</p>
		</div>
	</section>
	<section class="main">
		<h1 style="font-size: 22px;">AI-POWERED CAREER GUIDANCE AND EMPLOYABILITY ENHANCEMENT PLATFORM</h1>
		<p id="output"></p>
		<div class="bottom-section">
			<div class="input-container">
				<input type="text" />
				<div id="submit"><i class="fa-solid fa-paper-plane"></i></div>
			</div>
		</div>
	</section>

	<!-- Link JS -->
	<script>
	const submitButton = document.getElementById("submit");
	const outputEl = document.getElementById("output");
	const inputEl = document.querySelector("input");
	const historyEl = document.querySelector(".history");
	const buttonEl = document.querySelector("button");

	async function getMessage() {
		const msg = inputEl.value.trim();
		if (!msg) return;

		outputEl.innerHTML = '<i class="fa-solid fa-circle-notch fa-spin"></i> Analyzing with AI...';

		try {
			const response = await fetch("/api/chat", {
				method: "POST",
				headers: {
					"Content-Type": "application/json",
				},
				body: JSON.stringify({ message: msg }),
			});
			const data = await response.json();

			if (data.success && data.reply) {
				outputEl.textContent = data.reply;
			} else {
				outputEl.textContent = "Career Guidance: Focus on foundational skills like DSA, core CS subjects, and building real-world portfolio projects!";
			}

			const pEl = document.createElement("p");
			pEl.textContent = msg;
			historyEl.appendChild(pEl);
			inputEl.value = "";
		} catch (e) {
			console.error(e);
			outputEl.textContent = "AI service temporarily unavailable. Please try again shortly.";
		}
	}
	function clearInput() {
		outputEl.textContent = "";
		inputEl.value = "";
	}
	submitButton.addEventListener("click", getMessage);
	buttonEl.addEventListener("click", clearInput);
	inputEl.addEventListener("keypress", (e) => {
		if (e.key === "Enter") getMessage();
	});
	</script>
</body>

</html>