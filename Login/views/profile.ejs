<!DOCTYPE html>
<html lang="en">

<head>
  <meta charset="UTF-8">
  <title>My Profile | AI-POWERED CAREER GUIDANCE AND EMPLOYABILITY ENHANCEMENT PLATFORM</title>
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.0/css/all.min.css">

  <style>
    body {
      margin: 0;
      font-family: 'Segoe UI', sans-serif;
      background: linear-gradient(135deg, #667eea, #764ba2);
      min-height: 100vh;
      display: flex;
      justify-content: center;
      align-items: center;
    }

    .profile-container {
      background: #ffffff;
      width: 92%;
      max-width: 950px;
      border-radius: 16px;
      padding: 30px;
      box-shadow: 0 20px 45px rgba(0, 0, 0, 0.25);
    }

    .profile-header {
      text-align: center;
      margin-bottom: 30px;
    }

    .profile-header h2 {
      margin: 0;
      color: #333;
    }

    .profile-header p {
      color: #777;
      font-size: 14px;
    }

    .profile-grid {
      display: grid;
      grid-template-columns: repeat(auto-fit, minmax(220px, 1fr));
      gap: 20px;
      margin-bottom: 30px;
    }

    .profile-box {
      background: #f5f7ff;
      padding: 18px;
      border-radius: 12px;
    }

    .profile-box span {
      display: block;
      font-size: 13px;
      color: #666;
    }

    .profile-box strong {
      font-size: 15px;
      color: #222;
      word-break: break-all;
      /* breaks long emails */
      overflow-wrap: anywhere;
      /* responsive fix */
    }

    .btn-group {
      text-align: center;
      margin-bottom: 20px;
    }

    .btn {
      text-decoration: none;
      background: #667eea;
      color: white;
      padding: 10px 18px;
      border-radius: 8px;
      font-size: 14px;
      margin: 5px;
      display: inline-block;
      cursor: pointer;
      border: none;
    }

    .btn:hover {
      background: #5a6fd8;
    }

    .edit-form {
      display: none;
      background: #f9f9ff;
      padding: 25px;
      border-radius: 14px;
      margin-top: 25px;
    }

    label {
      font-size: 14px;
      display: block;
      margin-top: 15px;
    }

    input,
    select {
      width: 100%;
      box-sizing: border-box;
      padding: 10px;
      margin-top: 6px;
      border-radius: 6px;
      border: 1px solid #ccc;
    }

    @media (max-width: 600px) {
      .profile-container {
        padding: 20px;
      }
    }

    .quiz-percentage {
      font-size: 13px;
      font-weight: normal;
    }

    .ats-score {
      font-size: 15px;
      font-weight: 800;
    }

    .good {
      color: #10b981;
    }

    .average {
      color: #f59e0b;
    }

    .poor {
      color: #ef4444;
    }
  </style>
</head>

<body>

  <div class="profile-container">

    <!-- HEADER -->
    <div class="profile-header">
      <h2>
        <%= user.name %>
      </h2>
      <p>
        <%= user.email %>
      </p>
    </div>

    <!-- PROFILE DETAILS -->
    <div class="profile-grid">
      <div class="profile-box">
        <span>Full Name</span>
        <strong>
          <%= user.name %>
        </strong>
      </div>

      <div class="profile-box">
        <span>Email</span>
        <strong>
          <%= user.email %>
        </strong>
      </div>

      <div class="profile-box">
        <span>Phone</span>
        <strong>
          <%= user.phone || 'Not provided' %>
        </strong>
      </div>

      <div class="profile-box">
        <span>Age</span>
        <strong>
          <%= user.age || 'Not provided' %>
        </strong>
      </div>

      <div class="profile-box">
        <span>Gender</span>
        <strong>
          <%= user.gender || 'Not specified' %>
        </strong>
      </div>

      <div class="profile-box">
        <span>Education</span>
        <strong>
          <%= user.education || 'Not specified' %>
        </strong>
      </div>

      <div class="profile-box">
        <span>Account Created</span>
        <strong>
          <%= new Date(user.createdAt).toDateString() %>
        </strong>
      </div>
    </div>

    <!-- QUIZ & TRIVIA HISTORY -->
    <div style="margin-top: 10px; margin-bottom: 25px; border-top: 1px solid #eef0f8; padding-top: 20px;">
      <div
        style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 15px; flex-wrap: wrap; gap: 10px;">
        <h3 style="margin: 0; color: #333; font-size: 18px;"><i class="fa-solid fa-bullseye"
            style="color: #667eea; margin-right: 8px;"></i>Quiz & Assessment History</h3>
        <a href="/trivia" class="btn" style="margin: 0; padding: 7px 16px; font-size: 13px;"><i class="fa-solid fa-play"
            style="margin-right: 5px;"></i>Take Quiz</a>
      </div>

      <% if (user.quizScores && user.quizScores.length> 0) { %>
        <div style="display: grid; grid-template-columns: repeat(auto-fill, minmax(200px, 1fr)); gap: 12px;">
          <% user.quizScores.slice().reverse().slice(0, 6).forEach(function(quiz) { %>
            <div style="background: #f8faff; border: 1px solid #e3e8f8; border-radius: 10px; padding: 12px;">
              <div
                style="font-size: 12px; color: #667eea; font-weight: bold; margin-bottom: 4px; white-space: nowrap; overflow: hidden; text-overflow: ellipsis;"
                title="<%= quiz.category %>">
                <%= quiz.category %>
              </div>
              <div style="font-size: 20px; font-weight: bold; color: #222;">
                <%= quiz.score %> / <%= quiz.total %>
                    <span
                      class="quiz-percentage <%= quiz.percentage >= 70 ? 'good' : quiz.percentage >= 40 ? 'average' : 'poor' %>">
                      (<%= quiz.percentage %>%)
                    </span>
              </div>
              <div style="font-size: 11px; color: #888; margin-top: 4px;">
                <%= new Date(quiz.date).toLocaleDateString() %>
              </div>
            </div>
            <% }); %>
        </div>
        <% } else { %>
          <p style="color: #777; font-size: 14px; margin: 0;">No quiz scores recorded yet. <a href="/trivia"
              style="color: #667eea; font-weight: 600;">Start your first quiz</a> to track and benchmark your skills!
          </p>
          <% } %>
    </div>

    <!-- RESUME ATS SCANS & OPTIMIZATION HISTORY -->
    <div style="margin-top: 10px; margin-bottom: 25px; border-top: 1px solid #eef0f8; padding-top: 20px;">
      <div
        style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 15px; flex-wrap: wrap; gap: 10px;">
        <h3 style="margin: 0; color: #333; font-size: 18px;"><i class="fa-solid fa-file-lines"
            style="color: #667eea; margin-right: 8px;"></i>Resume ATS Scans & Optimization History</h3>
        <a href="/resume-analyzer" class="btn"
          style="margin: 0; padding: 7px 16px; font-size: 13px; background: linear-gradient(135deg, #667eea, #764ba2);"><i
            class="fa-solid fa-upload" style="margin-right: 5px;"></i>Scan
          Resume</a>
      </div>

      <% if (user.resumeAnalyses && user.resumeAnalyses.length> 0) { %>
        <div style="display: grid; grid-template-columns: repeat(auto-fill, minmax(260px, 1fr)); gap: 14px;">
          <% user.resumeAnalyses.slice().reverse().slice(0, 4).forEach(function(scan) { %>
            <div style="background: #f8faff; border: 1.5px solid #e3e8f8; border-radius: 12px; padding: 14px;">
              <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 6px;">
                <span style="font-size: 13px; color: #667eea; font-weight: 800;">
                  <%= scan.targetRole %>
                </span>
                <span class="ats-score <%= scan.atsScore >= 75 ? 'good' : scan.atsScore >= 50 ? 'average' : 'poor' %>">
                  <%= scan.atsScore %>/100
                </span>
              </div>
              <div
                style="font-size: 12px; color: #475569; margin-bottom: 6px; white-space: nowrap; overflow: hidden; text-overflow: ellipsis;"
                title="<%= scan.fileName %>">
                <i class="fa-solid fa-file-pdf"></i>
                <%= scan.fileName %>
              </div>
              <div style="font-size: 11px; color: #64748b; margin-bottom: 8px;">
                <%= scan.foundKeywords ? scan.foundKeywords.length : 0 %> matched | <%= scan.missingKeywords ?
                    scan.missingKeywords.length : 0 %> missing
              </div>
              <div style="font-size: 11px; color: #888;">
                <%= new Date(scan.date).toLocaleDateString() %>
              </div>
            </div>
            <% }); %>
        </div>
        <% } else { %>
          <p style="color: #777; font-size: 14px; margin: 0;">
            No resume ATS scans recorded yet. <a href="/resume-analyzer"
              style="color: #667eea; font-weight: 600;">Upload and analyze your resume</a> to calculate your ATS score
            and get tailored keyword recommendations!
          </p>
          <% } %>
    </div>

    <!-- BUTTONS -->
    <div class="btn-group">
      <button class="btn" onclick="toggleEdit()"><i class="fa-solid fa-pen-to-square"
          style="margin-right: 6px;"></i>Edit Profile</button>
      <a href="/dashboard" class="btn"><i class="fa-solid fa-arrow-left" style="margin-right: 6px;"></i>Back to
        Dashboard</a>
    </div>

    <!-- EDIT PROFILE FORM -->
    <div class="edit-form" id="editForm">
      <form action="/edit-profile" method="POST">

        <label>Phone</label>
        <input type="text" name="phone" value="<%= user.phone || '' %>">

        <label>Age</label>
        <input type="number" name="age" value="<%= user.age || '' %>">

        <label>Gender</label>
        <select name="gender">
          <option value="">Select</option>
          <option value="Male" <%=user.gender==='Male' ? 'selected' : '' %>>Male</option>
          <option value="Female" <%=user.gender==='Female' ? 'selected' : '' %>>Female</option>
          <option value="Other" <%=user.gender==='Other' ? 'selected' : '' %>>Other</option>
        </select>

        <label>Education</label>
        <input type="text" name="education" value="<%= user.education || '' %>">

        <button type="submit" class="btn" style="width:100%; margin-top:20px;">
          Save Changes
        </button>
      </form>
    </div>

  </div>

  <script>
    function toggleEdit() {
      const form = document.getElementById("editForm");
      form.style.display = window.getComputedStyle(form).display === "none" ? "block" : "none";
    }
  </script>

</body>

</html>