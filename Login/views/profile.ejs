<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <title>My Profile</title>
  <meta name="viewport" content="width=device-width, initial-scale=1.0">

  <style>
    body {
      margin: 0;
      font-family: 'Segoe UI', sans-serif;
      background: linear-gradient(135deg, #667eea, #764ba2);
      min-height: 100vh;
      display: flex;
      justify-content: center;
      align-items: center;
    }

    .profile-container {
      background: #ffffff;
      width: 92%;
      max-width: 950px;
      border-radius: 16px;
      padding: 30px;
      box-shadow: 0 20px 45px rgba(0,0,0,0.25);
    }

    .profile-header {
      text-align: center;
      margin-bottom: 30px;
    }

    .profile-header h2 {
      margin: 0;
      color: #333;
    }

    .profile-header p {
      color: #777;
      font-size: 14px;
    }

    .profile-grid {
      display: grid;
      grid-template-columns: repeat(auto-fit, minmax(220px, 1fr));
      gap: 20px;
      margin-bottom: 30px;
    }

    .profile-box {
      background: #f5f7ff;
      padding: 18px;
      border-radius: 12px;
    }

    .profile-box span {
      display: block;
      font-size: 13px;
      color: #666;
    }

    .profile-box strong {
  font-size: 15px;
  color: #222;
  word-break: break-all;      /* ✅ breaks long emails */
  overflow-wrap: anywhere;   /* ✅ responsive fix */
}

    .btn-group {
      text-align: center;
      margin-bottom: 20px;
    }

    .btn {
      text-decoration: none;
      background: #667eea;
      color: white;
      padding: 10px 18px;
      border-radius: 8px;
      font-size: 14px;
      margin: 5px;
      display: inline-block;
      cursor: pointer;
      border: none;
    }

    .btn:hover {
      background: #5a6fd8;
    }

    .edit-form {
      display: none;
      background: #f9f9ff;
      padding: 25px;
      border-radius: 14px;
      margin-top: 25px;
    }

    label {
      font-size: 14px;
      display: block;
      margin-top: 15px;
    }

    input, select {
      width: 100%;
      padding: 10px;
      margin-top: 6px;
      border-radius: 6px;
      border: 1px solid #ccc;
    }

    @media (max-width: 600px) {
      .profile-container {
        padding: 20px;
      }
    }
  </style>
</head>
<body>

<div class="profile-container">

  <!-- HEADER -->
  <div class="profile-header">
    <h2><%= user.name %></h2>
    <p><%= user.email %></p>
  </div>

  <!-- PROFILE DETAILS -->
  <div class="profile-grid">
    <div class="profile-box">
      <span>Full Name</span>
      <strong><%= user.name %></strong>
    </div>

    <div class="profile-box">
      <span>Email</span>
      <strong><%= user.email %></strong>
    </div>

    <div class="profile-box">
      <span>Phone</span>
      <strong><%= user.phone || 'Not provided' %></strong>
    </div>

    <div class="profile-box">
      <span>Age</span>
      <strong><%= user.age || 'Not provided' %></strong>
    </div>

    <div class="profile-box">
      <span>Gender</span>
      <strong><%= user.gender || 'Not specified' %></strong>
    </div>

    <div class="profile-box">
      <span>Education</span>
      <strong><%= user.education || 'Not specified' %></strong>
    </div>

    <div class="profile-box">
      <span>Account Created</span>
      <strong><%= new Date(user.createdAt).toDateString() %></strong>
    </div>
  </div>

  <!-- BUTTONS -->
  <div class="btn-group">
    <button class="btn" onclick="toggleEdit()">✏️ Edit Profile</button>
    <a href="/dashboard" class="btn">← Back to Dashboard</a>
  </div>

  <!-- EDIT PROFILE FORM -->
  <div class="edit-form" id="editForm">
    <form action="/edit-profile" method="POST">

      <label>Phone</label>
      <input type="text" name="phone" value="<%= user.phone || '' %>">

      <label>Age</label>
      <input type="number" name="age" value="<%= user.age || '' %>">

      <label>Gender</label>
      <select name="gender">
        <option value="">Select</option>
        <option value="Male" <%= user.gender === 'Male' ? 'selected' : '' %>>Male</option>
        <option value="Female" <%= user.gender === 'Female' ? 'selected' : '' %>>Female</option>
        <option value="Other" <%= user.gender === 'Other' ? 'selected' : '' %>>Other</option>
      </select>

      <label>Education</label>
      <input type="text" name="education" value="<%= user.education || '' %>">

      <button type="submit" class="btn" style="width:100%; margin-top:20px;">
        Save Changes
      </button>
    </form>
  </div>

</div>

<script>
  function toggleEdit() {
    const form = document.getElementById("editForm");
    form.style.display = form.style.display === "none" ? "block" : "none";
  }
</script>

</body>
</html>
