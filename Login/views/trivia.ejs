<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <title>AI Career & Tech Trivia | AI-POWERED CAREER GUIDANCE AND EMPLOYABILITY ENHANCEMENT PLATFORM</title>
  <meta name="viewport" content="width=device-width, initial-scale=1.0">

  <!-- Font Awesome -->
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.0/css/all.min.css">
  <!-- Google Fonts -->
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700;800&display=swap" rel="stylesheet">

  <style>
    :root {
      --primary: #667eea;
      --primary-dark: #5a6fd8;
      --secondary: #764ba2;
      --accent: #10b981;
      --danger: #ef4444;
      --bg: #f4f6fb;
      --card-bg: #ffffff;
      --text-main: #1e293b;
      --text-muted: #64748b;
      --border: #e2e8f0;
    }

    * {
      box-sizing: border-box;
      margin: 0;
      padding: 0;
    }

    body {
      font-family: 'Plus Jakarta Sans', -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif;
      background: var(--bg);
      color: var(--text-main);
      min-height: 100vh;
      display: flex;
      flex-direction: column;
    }

    /* TOP NAVBAR */
    .navbar {
      background: #ffffff;
      border-bottom: 1px solid var(--border);
      padding: 14px 30px;
      display: flex;
      justify-content: space-between;
      align-items: center;
      position: sticky;
      top: 0;
      z-index: 50;
      box-shadow: 0 4px 20px rgba(0,0,0,0.03);
    }

    .brand {
      display: flex;
      align-items: center;
      gap: 12px;
      text-decoration: none;
      color: var(--text-main);
      font-weight: 700;
      font-size: 18px;
    }

    .brand-icon {
      width: 40px;
      height: 40px;
      border-radius: 10px;
      background: linear-gradient(135deg, var(--primary), var(--secondary));
      display: flex;
      align-items: center;
      justify-content: center;
      color: white;
      font-size: 18px;
    }

    .nav-actions {
      display: flex;
      align-items: center;
      gap: 12px;
    }

    .nav-btn {
      text-decoration: none;
      padding: 8px 16px;
      border-radius: 8px;
      font-size: 14px;
      font-weight: 600;
      transition: all 0.2s ease;
      display: inline-flex;
      align-items: center;
      gap: 6px;
    }

    .nav-btn-secondary {
      background: #f1f5f9;
      color: var(--text-main);
    }
    .nav-btn-secondary:hover {
      background: #e2e8f0;
    }

    .nav-btn-primary {
      background: linear-gradient(135deg, var(--primary), var(--secondary));
      color: white;
    }
    .nav-btn-primary:hover {
      opacity: 0.95;
      transform: translateY(-1px);
    }

    .user-pill {
      background: #eff6ff;
      color: var(--primary);
      padding: 6px 14px;
      border-radius: 20px;
      font-size: 13px;
      font-weight: 600;
      display: flex;
      align-items: center;
      gap: 6px;
    }

    /* MAIN CONTAINER */
    .container {
      max-width: 860px;
      margin: 30px auto;
      padding: 0 20px;
      width: 100%;
      flex: 1;
    }

    /* CARD COMPONENT */
    .quiz-card {
      background: var(--card-bg);
      border-radius: 20px;
      padding: 35px;
      box-shadow: 0 15px 45px rgba(102, 126, 234, 0.08);
      border: 1px solid rgba(226, 232, 240, 0.8);
      transition: all 0.3s ease;
    }

    /* HEADER BANNER */
    .header-banner {
      background: linear-gradient(135deg, var(--primary), var(--secondary));
      border-radius: 16px;
      padding: 26px 30px;
      color: white;
      margin-bottom: 25px;
      display: flex;
      justify-content: space-between;
      align-items: center;
      flex-wrap: wrap;
      gap: 15px;
    }

    .header-banner h1 {
      font-size: 24px;
      font-weight: 800;
      letter-spacing: -0.5px;
    }

    .header-banner p {
      font-size: 14px;
      opacity: 0.9;
      margin-top: 4px;
    }

    /* SETUP SCREEN */
    .setup-grid {
      display: grid;
      grid-template-columns: 1fr 1fr;
      gap: 20px;
      margin-bottom: 25px;
    }

    @media (max-width: 640px) {
      .setup-grid {
        grid-template-columns: 1fr;
      }
    }

    .form-group {
      display: flex;
      flex-direction: column;
      gap: 8px;
    }

    .form-group label {
      font-size: 14px;
      font-weight: 700;
      color: #334155;
      display: flex;
      align-items: center;
      gap: 6px;
    }

    .form-control {
      padding: 12px 16px;
      border-radius: 12px;
      border: 1.5px solid var(--border);
      font-size: 15px;
      font-family: inherit;
      color: var(--text-main);
      background: #f8fafc;
      transition: all 0.2s ease;
      outline: none;
    }

    .form-control:focus {
      border-color: var(--primary);
      background: #ffffff;
      box-shadow: 0 0 0 3px rgba(102, 126, 234, 0.15);
    }

    .start-btn {
      width: 100%;
      padding: 15px;
      border: none;
      border-radius: 14px;
      background: linear-gradient(135deg, var(--primary), var(--secondary));
      color: white;
      font-size: 16px;
      font-weight: 700;
      font-family: inherit;
      cursor: pointer;
      display: flex;
      align-items: center;
      justify-content: center;
      gap: 10px;
      transition: all 0.2s ease;
      box-shadow: 0 10px 25px rgba(102, 126, 234, 0.3);
    }

    .start-btn:hover {
      transform: translateY(-2px);
      box-shadow: 0 14px 30px rgba(102, 126, 234, 0.4);
    }

    /* LIVE QUIZ SCREEN */
    .quiz-screen {
      display: none;
    }

    .meta-bar {
      display: flex;
      justify-content: space-between;
      align-items: center;
      margin-bottom: 18px;
      flex-wrap: wrap;
      gap: 10px;
    }

    .badge {
      display: inline-flex;
      align-items: center;
      gap: 6px;
      padding: 6px 12px;
      border-radius: 20px;
      font-size: 12px;
      font-weight: 700;
      background: #f1f5f9;
      color: #475569;
    }

    .badge-primary {
      background: #ede9fe;
      color: #6d28d9;
    }

    .badge-score {
      background: #ecfdf5;
      color: #065f46;
      font-size: 14px;
    }

    /* PROGRESS BAR */
    .progress-container {
      height: 8px;
      background: #e2e8f0;
      border-radius: 10px;
      overflow: hidden;
      margin-bottom: 25px;
    }

    .progress-fill {
      height: 100%;
      background: linear-gradient(90deg, var(--primary), var(--secondary));
      width: 0%;
      transition: width 0.3s ease;
    }

    /* QUESTION TEXT */
    .question-title {
      font-size: 20px;
      font-weight: 700;
      color: var(--text-main);
      line-height: 1.45;
      margin-bottom: 24px;
    }

    /* OPTIONS GRID */
    .options-grid {
      display: grid;
      grid-template-columns: 1fr;
      gap: 14px;
      margin-bottom: 25px;
    }

    .option-btn {
      display: flex;
      align-items: center;
      gap: 14px;
      width: 100%;
      padding: 16px 20px;
      background: #f8fafc;
      border: 1.5px solid #e2e8f0;
      border-radius: 14px;
      font-size: 15px;
      font-weight: 600;
      font-family: inherit;
      color: var(--text-main);
      cursor: pointer;
      text-align: left;
      transition: all 0.2s cubic-bezier(0.16, 1, 0.3, 1);
    }

    .option-btn:hover:not(:disabled) {
      background: #f1f5f9;
      border-color: var(--primary);
      transform: translateY(-1px);
    }

    .option-tag {
      width: 32px;
      height: 32px;
      border-radius: 8px;
      background: #e2e8f0;
      color: #475569;
      display: flex;
      align-items: center;
      justify-content: center;
      font-weight: 700;
      font-size: 13px;
      flex-shrink: 0;
      transition: all 0.2s;
    }

    .option-text {
      flex: 1;
      line-height: 1.4;
    }

    /* OPTION STATES */
    .option-btn.correct {
      background: #ecfdf5 !important;
      border-color: var(--accent) !important;
      color: #065f46 !important;
    }
    .option-btn.correct .option-tag {
      background: var(--accent);
      color: white;
    }

    .option-btn.incorrect {
      background: #fef2f2 !important;
      border-color: var(--danger) !important;
      color: #991b1b !important;
    }
    .option-btn.incorrect .option-tag {
      background: var(--danger);
      color: white;
    }

    .option-btn:disabled {
      cursor: not-allowed;
      opacity: 0.9;
    }

    /* FEEDBACK BANNER */
    .feedback-banner {
      display: none;
      padding: 14px 18px;
      border-radius: 12px;
      font-size: 14px;
      font-weight: 600;
      margin-bottom: 20px;
      animation: fadeIn 0.3s ease;
    }

    .feedback-banner.correct {
      background: #d1fae5;
      color: #065f46;
      border: 1px solid #a7f3d0;
    }

    .feedback-banner.incorrect {
      background: #fee2e2;
      color: #991b1b;
      border: 1px solid #fecaca;
    }

    /* ACTION BAR */
    .action-bar {
      display: flex;
      justify-content: space-between;
      align-items: center;
      gap: 12px;
    }

    .action-btn {
      padding: 12px 24px;
      border-radius: 10px;
      font-size: 14px;
      font-weight: 700;
      font-family: inherit;
      cursor: pointer;
      border: none;
      display: inline-flex;
      align-items: center;
      gap: 8px;
      transition: all 0.2s ease;
    }

    .action-btn-primary {
      background: linear-gradient(135deg, var(--primary), var(--secondary));
      color: white;
      margin-left: auto;
    }
    .action-btn-primary:disabled {
      background: #cbd5e1;
      cursor: not-allowed;
      transform: none !important;
      box-shadow: none !important;
    }

    /* RESULTS SCREEN */
    .results-screen {
      display: none;
      text-align: center;
      padding: 20px 0;
    }

    .result-badge {
      width: 90px;
      height: 90px;
      border-radius: 50%;
      background: linear-gradient(135deg, #ede9fe, #dbeafe);
      color: var(--primary);
      display: flex;
      align-items: center;
      justify-content: center;
      font-size: 40px;
      margin: 0 auto 20px;
      box-shadow: 0 10px 25px rgba(102, 126, 234, 0.15);
    }

    .result-score {
      font-size: 48px;
      font-weight: 800;
      color: var(--text-main);
      margin-bottom: 8px;
      letter-spacing: -1px;
    }

    .result-percentage {
      font-size: 18px;
      font-weight: 700;
      color: var(--primary);
      margin-bottom: 12px;
    }

    .result-msg {
      font-size: 15px;
      color: var(--text-muted);
      max-width: 480px;
      margin: 0 auto 25px;
      line-height: 1.5;
    }

    .sync-status {
      display: inline-flex;
      align-items: center;
      gap: 8px;
      padding: 8px 16px;
      border-radius: 20px;
      font-size: 13px;
      font-weight: 600;
      background: #ecfdf5;
      color: #065f46;
      margin-bottom: 30px;
    }

    .sync-status.syncing {
      background: #eff6ff;
      color: #1d4ed8;
    }

    .results-actions {
      display: flex;
      justify-content: center;
      gap: 12px;
      flex-wrap: wrap;
    }

    /* LOADING SPINNER */
    .spinner {
      display: inline-block;
      width: 18px;
      height: 18px;
      border: 2px solid rgba(255,255,255,0.3);
      border-radius: 50%;
      border-top-color: white;
      animation: spin 0.8s linear infinite;
    }

    @keyframes spin {
      to { transform: rotate(360deg); }
    }

    @keyframes fadeIn {
      from { opacity: 0; transform: translateY(-6px); }
      to { opacity: 1; transform: translateY(0); }
    }
  </style>
</head>
<body>

  <!-- TOP NAVIGATION -->
  <nav class="navbar">
    <a href="/dashboard" class="brand">
      <div class="brand-icon">
        <i class="fa-solid fa-graduation-cap"></i>
      </div>
      <span style="font-size: 15px; font-weight: 800; letter-spacing: 0.3px;">AI-POWERED CAREER GUIDANCE AND EMPLOYABILITY ENHANCEMENT PLATFORM</span>
    </a>

    <div class="nav-actions">
      <% if (isLoggedIn) { %>
        <div class="user-pill">
          <i class="fa-solid fa-user-check"></i>
          <span><%= name %></span>
        </div>
        <a href="/profile" class="nav-btn nav-btn-secondary" title="View Profile">
          <i class="fa-solid fa-id-card"></i> Profile
        </a>
      <% } else { %>
        <a href="/" class="nav-btn nav-btn-secondary">
          <i class="fa-solid fa-right-to-bracket"></i> Login
        </a>
      <% } %>
      <a href="/dashboard" class="nav-btn nav-btn-primary">
        <i class="fa-solid fa-house"></i> Dashboard
      </a>
    </div>
  </nav>

  <!-- MAIN CONTAINER -->
  <main class="container">

    <!-- HEADER BANNER -->
    <div class="header-banner">
      <div>
        <h1><i class="fa-solid fa-bullseye" style="color: var(--primary); margin-right: 8px;"></i>AI Career & Knowledge Trivia</h1>
        <p>Test your competencies, discover career strengths, and log your progress.</p>
      </div>
      <div class="badge badge-score" id="backendBadge">
        <i class="fa-solid fa-circle-check"></i> Backend Connected
      </div>
    </div>

    <!-- MAIN CARD -->
    <div class="quiz-card">

      <!-- 1. SETUP / CONFIGURATION SCREEN -->
      <section id="setupScreen">
        <div class="setup-grid">
          <div class="form-group">
            <label for="categorySelect">
              <i class="fa-solid fa-layer-group" style="color: var(--primary);"></i> Select Domain or Category
            </label>
            <select id="categorySelect" class="form-control">
              <option value="tech-cs">Computer Science & IT (Career Focus)</option>
              <option value="tech-web">Web Development & JavaScript</option>
              <option value="tech-ai">Data Science & Artificial Intelligence</option>
              <option value="aptitude-logic">Aptitude & Logical Reasoning</option>
              <option value="18">Science: Computers (OpenTDB)</option>
              <option value="19">Science: Mathematics (OpenTDB)</option>
              <option value="9">General Knowledge (OpenTDB)</option>
            </select>
          </div>

          <div class="form-group">
            <label for="amountSelect">
              <i class="fa-solid fa-list-ol" style="color: var(--primary);"></i> Number of Questions
            </label>
            <select id="amountSelect" class="form-control">
              <option value="5">5 Questions (Quick Check)</option>
              <option value="10" selected>10 Questions (Standard Assessment)</option>
              <option value="15">15 Questions (In-depth Test)</option>
              <option value="20">20 Questions (Comprehensive)</option>
            </select>
          </div>

          <div class="form-group">
            <label for="difficultySelect">
              <i class="fa-solid fa-gauge-high" style="color: var(--primary);"></i> Difficulty Level
            </label>
            <select id="difficultySelect" class="form-control">
              <option value="">Any Difficulty (Dynamic)</option>
              <option value="easy">Easy (Fundamentals)</option>
              <option value="medium" selected>Medium (Standard Interview)</option>
              <option value="hard">Hard (Advanced Topics)</option>
            </select>
          </div>

          <div class="form-group">
            <label>
              <i class="fa-solid fa-cloud-arrow-up" style="color: var(--primary);"></i> Profile Synchronization
            </label>
            <div style="padding: 12px 16px; background: #f8fafc; border: 1.5px solid var(--border); border-radius: 12px; font-size: 14px; color: #475569; display: flex; align-items: center; gap: 8px;">
              <% if (isLoggedIn) { %>
                <i class="fa-solid fa-circle-check" style="color: var(--accent);"></i>
                <span>Active session: <strong><%= name %></strong></span>
              <% } else { %>
                <i class="fa-solid fa-info-circle" style="color: var(--primary);"></i>
                <span>Guest mode (scores previewed locally)</span>
              <% } %>
            </div>
          </div>
        </div>

        <button id="startBtn" class="start-btn">
          <span>Start Assessment Now</span>
          <i class="fa-solid fa-arrow-right"></i>
        </button>
      </section>

      <!-- 2. ACTIVE QUIZ SCREEN -->
      <section id="quizScreen" class="quiz-screen">
        <div class="meta-bar">
          <div style="display: flex; gap: 8px; flex-wrap: wrap;">
            <span class="badge badge-primary" id="quizCategoryBadge">Computer Science</span>
            <span class="badge" id="quizCounterBadge">Question 1 / 10</span>
          </div>
          <div class="badge badge-score" id="quizScoreBadge">
            <i class="fa-solid fa-award"></i> Score: 0 / 10
          </div>
        </div>

        <!-- PROGRESS BAR -->
        <div class="progress-container">
          <div id="progressFill" class="progress-fill"></div>
        </div>

        <!-- QUESTION -->
        <h2 id="questionText" class="question-title">Loading question...</h2>

        <!-- OPTIONS -->
        <div id="optionsContainer" class="options-grid"></div>

        <!-- FEEDBACK BANNER -->
        <div id="feedbackBanner" class="feedback-banner"></div>

        <!-- BOTTOM ACTION BAR -->
        <div class="action-bar">
          <button id="restartBtn" class="action-btn" style="background: #f1f5f9; color: #475569;">
            <i class="fa-solid fa-rotate-left"></i> Reset
          </button>
          <button id="nextBtn" class="action-btn action-btn-primary" disabled>
            <span>Next Question</span>
            <i class="fa-solid fa-arrow-right"></i>
          </button>
        </div>
      </section>

      <!-- 3. COMPLETION / RESULTS SCREEN -->
      <section id="resultsScreen" class="results-screen">
        <div class="result-badge" id="resultIcon">
          <i class="fa-solid fa-trophy"></i>
        </div>

        <h2 id="resultTitle" style="font-size: 26px; font-weight: 800; margin-bottom: 8px;">Assessment Completed!</h2>
        <div class="result-score" id="resultScore">0 / 10</div>
        <div class="result-percentage" id="resultPercentage">Score: 0%</div>
        <p class="result-msg" id="resultMsg">Great effort! Review your answers or take another test to enhance your career preparation.</p>

        <div id="syncStatus" class="sync-status syncing">
          <div class="spinner"></div>
          <span>Saving score to backend...</span>
        </div>

        <div class="results-actions">
          <button id="playAgainBtn" class="nav-btn nav-btn-primary" style="padding: 12px 24px; font-size: 15px; cursor: pointer;">
            <i class="fa-solid fa-rotate"></i> Retake Test
          </button>
          <button id="changeCategoryBtn" class="nav-btn nav-btn-secondary" style="padding: 12px 24px; font-size: 15px; cursor: pointer;">
            <i class="fa-solid fa-list"></i> Change Category
          </button>
          <% if (isLoggedIn) { %>
            <a href="/profile" class="nav-btn nav-btn-secondary" style="padding: 12px 24px; font-size: 15px;">
              <i class="fa-solid fa-chart-line"></i> View Profile
            </a>
          <% } %>
          <a href="/dashboard" class="nav-btn nav-btn-secondary" style="padding: 12px 24px; font-size: 15px;">
            <i class="fa-solid fa-house"></i> Dashboard
          </a>
        </div>
      </section>

    </div>
  </main>

  <script>
    // State management
    let questions = [];
    let currentIndex = 0;
    let score = 0;
    let selectedCategoryName = "General";
    let isAnswered = false;

    // DOM Elements
    const setupScreen = document.getElementById("setupScreen");
    const quizScreen = document.getElementById("quizScreen");
    const resultsScreen = document.getElementById("resultsScreen");

    const categorySelect = document.getElementById("categorySelect");
    const amountSelect = document.getElementById("amountSelect");
    const difficultySelect = document.getElementById("difficultySelect");
    const startBtn = document.getElementById("startBtn");

    const quizCategoryBadge = document.getElementById("quizCategoryBadge");
    const quizCounterBadge = document.getElementById("quizCounterBadge");
    const quizScoreBadge = document.getElementById("quizScoreBadge");
    const progressFill = document.getElementById("progressFill");
    const questionText = document.getElementById("questionText");
    const optionsContainer = document.getElementById("optionsContainer");
    const feedbackBanner = document.getElementById("feedbackBanner");
    const nextBtn = document.getElementById("nextBtn");
    const restartBtn = document.getElementById("restartBtn");

    const resultScore = document.getElementById("resultScore");
    const resultPercentage = document.getElementById("resultPercentage");
    const resultTitle = document.getElementById("resultTitle");
    const resultMsg = document.getElementById("resultMsg");
    const resultIcon = document.getElementById("resultIcon");
    const syncStatus = document.getElementById("syncStatus");
    const playAgainBtn = document.getElementById("playAgainBtn");
    const changeCategoryBtn = document.getElementById("changeCategoryBtn");

    // Fetch dynamic categories from Backend API on page load
    async function loadCategories() {
      try {
        const res = await fetch("/api/trivia/categories");
        if (res.ok) {
          const data = await res.json();
          if (data.categories && data.categories.length > 0) {
            categorySelect.innerHTML = "";
            data.categories.forEach(cat => {
              const opt = document.createElement("option");
              opt.value = cat.id;
              opt.textContent = cat.name;
              categorySelect.appendChild(opt);
            });
          }
        }
      } catch (err) {
        console.warn("Using default category options:", err);
      }
    }

    // Start Quiz handler
    startBtn.addEventListener("click", async () => {
      const category = categorySelect.value;
      const amount = amountSelect.value;
      const difficulty = difficultySelect.value;
      selectedCategoryName = categorySelect.options[categorySelect.selectedIndex].text;

      startBtn.disabled = true;
      startBtn.innerHTML = `<span class="spinner"></span> Loading Questions...`;

      try {
        const queryParams = new URLSearchParams({
          category,
          amount,
          difficulty
        });

        const res = await fetch(`/api/trivia/questions?${queryParams.toString()}`);
        const data = await res.json();

        if (data.questions && data.questions.length > 0) {
          questions = data.questions;
          selectedCategoryName = data.category || selectedCategoryName;
          startQuizFlow();
        } else {
          alert("Could not load questions for this category. Please try another selection.");
        }
      } catch (error) {
        console.error("Error loading questions:", error);
        alert("Server error while retrieving questions. Please check network connection.");
      } finally {
        startBtn.disabled = false;
        startBtn.innerHTML = `<span>Start Assessment Now</span> <i class="fa-solid fa-arrow-right"></i>`;
      }
    });

    // Start the Quiz Interface
    function startQuizFlow() {
      currentIndex = 0;
      score = 0;
      setupScreen.style.display = "none";
      resultsScreen.style.display = "none";
      quizScreen.style.display = "block";
      renderQuestion();
    }

    // Render Current Question
    function renderQuestion() {
      isAnswered = false;
      const q = questions[currentIndex];
      const total = questions.length;

      // Badges & Progress
      quizCategoryBadge.textContent = selectedCategoryName;
      quizCounterBadge.textContent = `Question ${currentIndex + 1} / ${total}`;
      quizScoreBadge.innerHTML = `<i class="fa-solid fa-award"></i> Score: ${score} / ${total}`;
      const progressPercent = ((currentIndex) / total) * 100;
      progressFill.style.width = `${progressPercent}%`;

      // Question Title
      questionText.textContent = q.question;

      // Options
      optionsContainer.innerHTML = "";
      feedbackBanner.style.display = "none";
      nextBtn.disabled = true;
      nextBtn.innerHTML = currentIndex === total - 1
        ? `<span>Complete Assessment</span> <i class="fa-solid fa-flag-checkered"></i>`
        : `<span>Next Question</span> <i class="fa-solid fa-arrow-right"></i>`;

      const optionLabels = ["A", "B", "C", "D"];

      q.answers.forEach((ansText, idx) => {
        const btn = document.createElement("button");
        btn.className = "option-btn";
        btn.innerHTML = `
          <div class="option-tag">${optionLabels[idx] || "•"}</div>
          <span class="option-text">${ansText}</span>
        `;

        btn.addEventListener("click", () => handleSelectAnswer(btn, ansText, q.correct));
        optionsContainer.appendChild(btn);
      });
    }

    // Answer selection
    function handleSelectAnswer(clickedBtn, selectedAnswer, correctAnswer) {
      if (isAnswered) return;
      isAnswered = true;

      const buttons = optionsContainer.querySelectorAll(".option-btn");
      buttons.forEach(b => b.disabled = true);

      const isCorrect = selectedAnswer.trim() === correctAnswer.trim();

      if (isCorrect) {
        clickedBtn.classList.add("correct");
        score++;
        feedbackBanner.className = "feedback-banner correct";
        feedbackBanner.innerHTML = `<i class="fa-solid fa-circle-check"></i> Excellent! That is the correct answer.`;
      } else {
        clickedBtn.classList.add("incorrect");
        feedbackBanner.className = "feedback-banner incorrect";
        feedbackBanner.innerHTML = `<i class="fa-solid fa-circle-xmark"></i> Incorrect. Correct answer: <strong>${correctAnswer}</strong>`;

        // Highlight correct button
        buttons.forEach(b => {
          const textSpan = b.querySelector(".option-text");
          if (textSpan && textSpan.textContent.trim() === correctAnswer.trim()) {
            b.classList.add("correct");
          }
        });
      }

      feedbackBanner.style.display = "block";
      quizScoreBadge.innerHTML = `<i class="fa-solid fa-award"></i> Score: ${score} / ${questions.length}`;
      nextBtn.disabled = false;
    }

    // Next Question or Finish
    nextBtn.addEventListener("click", () => {
      currentIndex++;
      if (currentIndex < questions.length) {
        renderQuestion();
      } else {
        finishQuiz();
      }
    });

    // Reset Quiz
    restartBtn.addEventListener("click", () => {
      if (confirm("Are you sure you want to restart this assessment?")) {
        startQuizFlow();
      }
    });

    // Finish Quiz and Submit to Backend
    async function finishQuiz() {
      quizScreen.style.display = "none";
      resultsScreen.style.display = "block";
      progressFill.style.width = "100%";

      const total = questions.length;
      const percentage = Math.round((score / total) * 100);

      resultScore.textContent = `${score} / ${total}`;
      resultPercentage.textContent = `Score: ${percentage}%`;

      if (percentage >= 80) {
        resultTitle.textContent = "Outstanding Performance!";
        resultMsg.textContent = "Mastery demonstrated! Your strong aptitude and knowledge make you well-suited for advanced milestones.";
        resultIcon.innerHTML = `<i class="fa-solid fa-trophy" style="color: #f59e0b;"></i>`;
      } else if (percentage >= 50) {
        resultTitle.textContent = "Solid Effort!";
        resultMsg.textContent = "Good domain knowledge! Continued practice and coursework will take your proficiency to the next tier.";
        resultIcon.innerHTML = `<i class="fa-solid fa-award" style="color: var(--primary);"></i>`;
      } else {
        resultTitle.textContent = "Keep Growing!";
        resultMsg.textContent = "Every test is a learning stepping stone. Review key concepts and retry to build confidence!";
        resultIcon.innerHTML = `<i class="fa-solid fa-book-open" style="color: #6366f1;"></i>`;
      }

      // Sync with Backend API
      syncStatus.className = "sync-status syncing";
      syncStatus.innerHTML = `<div class="spinner"></div> <span>Recording score in MongoDB...</span>`;

      try {
        const response = await fetch("/api/trivia/submit", {
          method: "POST",
          headers: {
            "Content-Type": "application/json"
          },
          body: JSON.stringify({
            category: selectedCategoryName,
            score: score,
            total: total
          })
        });

        const data = await response.json();
        if (data.success && data.saved) {
          syncStatus.className = "sync-status";
          syncStatus.innerHTML = `<i class="fa-solid fa-circle-check"></i> <span>Score saved to your Career Profile!</span>`;
        } else if (data.success) {
          syncStatus.className = "sync-status";
          syncStatus.style.background = "#eff6ff";
          syncStatus.style.color = "#1d4ed8";
          syncStatus.innerHTML = `<i class="fa-solid fa-info-circle"></i> <span>Assessment completed as guest</span>`;
        } else {
          syncStatus.className = "sync-status";
          syncStatus.style.background = "#fef2f2";
          syncStatus.style.color = "#991b1b";
          syncStatus.innerHTML = `<i class="fa-solid fa-circle-exclamation"></i> <span>Could not record score</span>`;
        }
      } catch (err) {
        console.error("Score submission error:", err);
        syncStatus.className = "sync-status";
        syncStatus.style.background = "#fef2f2";
        syncStatus.style.color = "#991b1b";
        syncStatus.innerHTML = `<i class="fa-solid fa-circle-exclamation"></i> <span>Sync failed (offline or network error)</span>`;
      }
    }

    // Play Again button
    playAgainBtn.addEventListener("click", () => {
      startQuizFlow();
    });

    // Change Category button
    changeCategoryBtn.addEventListener("click", () => {
      resultsScreen.style.display = "none";
      quizScreen.style.display = "none";
      setupScreen.style.display = "block";
    });

    // Initialize
    loadCategories();
  </script>
</body>
</html>
