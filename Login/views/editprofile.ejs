<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <title>Edit Profile | AI-POWERED CAREER GUIDANCE AND EMPLOYABILITY ENHANCEMENT PLATFORM</title>
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.0/css/all.min.css">

  <style>
    body {
      margin: 0;
      font-family: 'Segoe UI', sans-serif;
      background: linear-gradient(135deg, #667eea, #764ba2);
      min-height: 100vh;
      display: flex;
      justify-content: center;
      align-items: center;
    }

    .edit-card {
      background: white;
      padding: 30px;
      width: 90%;
      max-width: 500px;
      border-radius: 14px;
      box-shadow: 0 20px 40px rgba(0,0,0,0.25);
    }

    h2 {
      text-align: center;
      margin-bottom: 20px;
      color: #333;
    }

    label {
      font-size: 14px;
      display: block;
      margin-top: 15px;
      color: #444;
      font-weight: 600;
    }

    input, select {
      width: 100%;
      box-sizing: border-box;
      padding: 10px;
      margin-top: 6px;
      border-radius: 6px;
      border: 1px solid #ccc;
    }

    button {
      width: 100%;
      margin-top: 25px;
      padding: 12px;
      background: #667eea;
      color: white;
      border: none;
      border-radius: 8px;
      font-size: 15px;
      cursor: pointer;
      font-weight: 600;
      transition: background 0.2s;
    }

    button:hover {
      background: #5a6fd8;
    }
  </style>
</head>
<body>

<div class="edit-card">
  <h2><i class="fa-solid fa-user-pen" style="color: #667eea; margin-right: 8px;"></i>Edit Profile</h2>

  <form action="/edit-profile" method="POST">

    <label>Phone</label>
    <input type="text" name="phone" value="<%= user.phone || '' %>">

    <label>Age</label>
    <input type="number" name="age" value="<%= user.age || '' %>">

    <label>Gender</label>
    <select name="gender">
      <option value="">Select</option>
      <option value="Male" <%= user.gender === 'Male' ? 'selected' : '' %>>Male</option>
      <option value="Female" <%= user.gender === 'Female' ? 'selected' : '' %>>Female</option>
      <option value="Other" <%= user.gender === 'Other' ? 'selected' : '' %>>Other</option>
    </select>

    <label>Education</label>
    <input type="text" name="education" value="<%= user.education || '' %>">

    <button type="submit"><i class="fa-solid fa-floppy-disk" style="margin-right: 6px;"></i>Save Changes</button>
    <a href="/profile" style="display: block; text-align: center; margin-top: 15px; text-decoration: none; color: #667eea; font-weight: 600; font-size: 14px;"><i class="fa-solid fa-arrow-left" style="margin-right: 6px;"></i>Back to Profile</a>
  </form>
</div>

</body>
</html>
